# Cheeku AI Voice OS - Environment Configuration

# Core Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# WebSocket Security & Authentication (Secure by Default)
# If AUTH_TOKEN is left unset, Cheeku automatically generates a secure token in backend/.cheeku_token.
# run.py automatically opens the frontend with this token (?token=...), providing frictionless local dev with zero unauthenticated exposure.
# Set AUTH_TOKEN to define an explicit static token (?token=your_secret or Authorization: Bearer your_secret).
AUTH_TOKEN=
WS_AUTH_REQUIRED=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ALLOW_ALL_ORIGINS=false
MAX_PAYLOAD_BYTES=1048576

# System Actions & Tools Sandboxing (Disabled by Default for Security)
# Controls whether desktop app launching, media controls, and browser URL opening are enabled.
# Set ENABLE_SYSTEM_ACTIONS=true to authorize host OS commands.
ENABLE_SYSTEM_ACTIONS=false
ALLOWED_SYSTEM_APPS=Safari,Google Chrome,Spotify,Terminal,Notes,Calculator,Visual Studio Code,Slack,Music,System Settings
REQUEST_TIMEOUT_SECONDS=15.0

# Groq Cloud LLM (Required for Conversational Intelligence)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: Microsoft Azure AI Speech (Studio Neural Voice)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_VOICE=en-US-Ava:DragonHDLatestNeural

# Optional: OpenAI / ElevenLabs TTS
OPENAI_API_KEY=
OPENAI_VOICE=nova
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Edge Neural TTS (Free Cloud Neural Voice)
EDGE_VOICE=en-US-AvaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz
